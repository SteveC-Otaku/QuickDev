{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "即栈 Quick Dev",
  "version": "0.2.0",
  "identifier": "com.quickdev.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "即栈 Quick Dev",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\scripts\\sign-windows.ps1 %1",
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
