{
  "name": "quick-dev",
  "version": "1.0.1",
  "description": "即栈 Quick Dev — Windows 多项目 dev 管理托盘工具",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:store": "node scripts/test-store.mjs",
    "ui:audit": "vite --config scripts/ui-audit.config.mjs --open /scripts/ui-audit.html",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "test": "node scripts/test-launch-plans.mjs && node scripts/test-project-roundtrip.mjs && node scripts/test-store.mjs && node scripts/test-release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.13.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
